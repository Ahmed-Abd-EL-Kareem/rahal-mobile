# API Configuration
EXPO_PUBLIC_API_URL=https://rahal-back-end.vercel.app/api/v1

# PostHog Analytics (optional)
EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe (Publishable key only - secret stays on backend)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Google Maps / MapLibre (optional - using free OSM)
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.example.com/style.json

# Sentry (optional)
EXPO_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# Google Sign-In Client IDs
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com