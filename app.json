{
  "expo": {
    "name": "Rahal",
    "slug": "rahal-mobile",
    "scheme": "rahal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-2.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo-2.png",
      "resizeMode": "contain",
      "backgroundColor": "#5F4100"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rahal.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app uses location to find nearby destinations and hotels.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app uses location to find nearby destinations and hotels.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to upload profile pictures.",
        "NSCameraUsageDescription": "This app needs access to your camera to take profile pictures.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-2.png",
        "backgroundColor": "#5F4100"
      },
      "package": "com.rahal.mobile",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/logo-2.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-secure-store",
      "expo-web-browser",
      "expo-location",
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#5F4100",
          "dark": {
            "image": "./assets/logo-2.png",
            "backgroundColor": "#141008"
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.rahal.mobile",
          "enableGooglePay": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "45b7c4e7-d415-42bd-8d98-5959ff2e63e1"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/your-project-id"
    },
    "owner": "ahmed-21"
  }
}
